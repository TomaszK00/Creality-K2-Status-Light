String normalizeColor(String c, const String& fallback) {
  if(c.length()!=7 || c[0]!='#')return fallback;
  for(int i=1;i<7;i++)if(!isxdigit((unsigned char)c[i]))return fallback;
  c.toLowerCase();return c;
}
uint32_t color24(const String& h) {return strtoul(h.c_str()+1,nullptr,16);}
void loadSettings(){
  prefs.begin("k2led",true);
  ssid=prefs.getString("ssid","");wifiPassword=prefs.getString("pass","");
  printerIP=prefs.getString("ip","192.168.1.9");printerPort=prefs.getUShort("port",7125);
  intervalMs=constrain(prefs.getInt("intvl",500),100,10000);
  activeLedCount=prefs.getInt("ledcnt",24)==12?12:24;
  int oldBright=constrain(prefs.getInt("bright",65),1,100);
  int oldPeriod=constrain(prefs.getInt("pulsems",1400),200,10000);
  uint8_t oldMask=prefs.isKey("pmask")?prefs.getUChar("pmask",0):0;
  bool oldLast=prefs.getBool("plast",false);
  if(!prefs.isKey("pmask")){String mode=prefs.getString("pulsemode","off");oldMask=mode=="all"?0x1f:(mode=="last"?1:0);oldLast=mode=="last";}
  for(int i=0;i<6;i++){
    String key=String(i);
    String oldColor=i==0?prefs.getString("color",DEFAULT_ROW_COLORS[0]):prefs.getString((String("c")+i).c_str(),DEFAULT_ROW_COLORS[i]);
    rowColors[i]=normalizeColor(prefs.getString((String("rc")+key).c_str(),oldColor),DEFAULT_ROW_COLORS[i]);
    rowBrightness[i]=constrain(prefs.getInt((String("rb")+key).c_str(),oldBright),1,100);
    rowPulse[i]=prefs.getBool((String("re")+key).c_str(),(oldMask&(1<<i))!=0);
    rowStyle[i]=constrain((int)prefs.getUChar((String("rs")+key).c_str(),(i==0&&oldLast)?1:0),0,5);
    rowPeriod[i]=constrain(prefs.getInt((String("rp")+key).c_str(),oldPeriod),200,10000);
  }
  prefs.end();
}
void saveNetwork(){prefs.begin("k2led",false);prefs.putString("ssid",ssid);prefs.putString("pass",wifiPassword);prefs.putString("ip",printerIP);prefs.putUShort("port",printerPort);prefs.end();}
void saveLighting(){prefs.begin("k2led",false);prefs.putInt("intvl",intervalMs);prefs.putInt("ledcnt",activeLedCount);for(int i=0;i<6;i++){String key=String(i);prefs.putString((String("rc")+key).c_str(),rowColors[i]);prefs.putInt((String("rb")+key).c_str(),rowBrightness[i]);prefs.putBool((String("re")+key).c_str(),rowPulse[i]);prefs.putUChar((String("rs")+key).c_str(),rowStyle[i]);prefs.putInt((String("rp")+key).c_str(),rowPeriod[i]);}prefs.end();}
void addRows(JsonDocument& d){for(int i=0;i<6;i++){const char* name=i==0?"progress":stateNames[i];d["rows"][name]["color"]=rowColors[i];d["rows"][name]["brightness"]=rowBrightness[i];d["rows"][name]["pulse"]=rowPulse[i];d["rows"][name]["period"]=rowPeriod[i];d["rows"][name]["style"]=rowStyle[i];}}

int statusIndex(String st){if(st=="printing")return 0;if(st=="heating")return 1;if(st=="paused")return 2;if(st=="complete")return 3;if(st=="error")return 4;return 5;}
String normalState(String s){s.toLowerCase();if(s=="complete"||s=="completed")return "complete";if(s=="printing")return "printing";if(s=="paused")return "paused";if(s=="error"||s=="cancelled")return "error";if(s=="heating")return "heating";return "standby";}
void updateLEDs(){
  if(!LED_ENABLED)return;
  String st=simEnabled?String(stateNames[simStatus]):normalState(printerState);
  if(!simEnabled&&!printerConnected)st="standby";
  int idx=statusIndex(st),pairs=activeLedCount/2;
  int count=st=="printing"?(int)ceilf((simEnabled?simProgress:printerProgress*100.0f)*pairs/100.0f):(st=="standby"&&!rowPulse[idx]?0:pairs);
  count=constrain(count,0,pairs);
  uint32_t rgb=color24(rowColors[idx]);uint8_t r=(rgb>>16)&255,g=(rgb>>8)&255,b=rgb&255;
  float cycle=(millis()%rowPeriod[idx])/(float)rowPeriod[idx];
  float scale=0.625f-0.375f*cosf(6.2831853f*cycle);
  float travel=cycle*2.0f*fmaxf(0,count-1);float head=travel<=count-1?travel:2.0f*(count-1)-travel;float centre=(count-1)/2.0f;float radius=fmaxf(0.5f,centre);float outward=1.0f-fabsf(2.0f*cycle-1.0f);float front=(rowStyle[idx]==3?outward:1.0f-outward)*radius;
  strip.setBrightness(map(rowBrightness[idx],0,100,0,255));
  for(int i=0;i<LED_COUNT;i++){
    int pair=i/2;bool lit=i<activeLedCount&&pair<count;float level=1.0f;
    if(lit&&rowPulse[idx]){
      if(rowStyle[idx]==2)level=fmaxf(0.08f,1.0f-fabsf(pair-head)/2.2f);
      else if(rowStyle[idx]==3||rowStyle[idx]==4)level=fmaxf(0.08f,1.0f-fabsf(fabsf(pair-centre)-front)/1.3f);
      else if(rowStyle[idx]==5)level=0.16f+0.84f*(0.5f+0.5f*cosf(6.2831853f*(pair/fmaxf(1,count-1)-cycle)));
      else if(rowStyle[idx]==0||(rowStyle[idx]==1&&pair==count-1))level=scale;
    }
    strip.setPixelColor(i,lit?strip.Color((uint8_t)(r*level),(uint8_t)(g*level),(uint8_t)(b*level),0):strip.Color(0,0,0,0));
  }
  strip.show();
}

void startNetwork(){
  WiFi.mode(WIFI_STA);
  if(ssid.length()){
    WiFi.begin(ssid.c_str(),wifiPassword.c_str());
    Serial.print("Connecting WiFi");
    for(int i=0;i<40 && WiFi.status()!=WL_CONNECTED;i++){delay(250);Serial.print('.');}
  }
  if(WiFi.status()==WL_CONNECTED){Serial.println("\nPanel: http://"+WiFi.localIP().toString());if(MDNS.begin("k2-led"))Serial.println("mDNS: http://k2-led.local");}
  else{apMode=true;WiFi.mode(WIFI_AP_STA);WiFi.softAP(AP_NAME,AP_PASSWORD);Serial.println("\nSetup AP: K2-LED-Setup · http://192.168.4.1");}
}
void pollPrinter(){
  if(apMode || WiFi.status()!=WL_CONNECTED){printerConnected=false;lastError="No printer connection (setup AP)";return;}
  WiFiClient client;HTTPClient http;
  String url="http://"+printerIP+":"+String(printerPort)+"/printer/objects/query?print_stats&virtual_sdcard";
  http.setTimeout(1700);
  if(!http.begin(client,url)){printerConnected=false;lastError="Invalid Moonraker URL";return;}
  int response=http.GET();if(response!=200){printerConnected=false;lastError="HTTP "+String(response);http.end();return;}
  JsonDocument doc;DeserializationError err=deserializeJson(doc,http.getStream());http.end();
  if(err){printerConnected=false;lastError=String("JSON: ")+err.c_str();return;}
  JsonVariant status=doc["result"]["status"];
  if(status["print_stats"].isNull()||status["virtual_sdcard"].isNull()){printerConnected=false;lastError="Missing printer fields";return;}
  printerState=status["print_stats"]["state"].as<String>();printerFile=status["print_stats"]["filename"].as<String>();
  printerProgress=constrain(status["virtual_sdcard"]["progress"].as<float>(),0.f,1.f);
  printerConnected=true;lastError="";
}
void jsonReply(int code, JsonDocument& d){String s;serializeJson(d,s);server.send(code,"application/json",s);}
void routes(){
