  server.on("/api/status",HTTP_GET,[](){JsonDocument d;d["version"]="2.8";d["connected"]=printerConnected;d["ap"]=apMode;d["state"]=normalState(printerState);d["progress"]=printerProgress;d["filename"]=printerFile;d["error"]=lastError;d["ssid"]=ssid;d["ip"]=printerIP;d["port"]=printerPort;d["interval"]=intervalMs;d["ledCount"]=activeLedCount;d["simLoop"]=simLoop;d["sim"]=simEnabled;d["simState"]=stateNames[simStatus];d["simProgress"]=simProgress;d["simRunning"]=simRun;addRows(d);jsonReply(200,d);});
