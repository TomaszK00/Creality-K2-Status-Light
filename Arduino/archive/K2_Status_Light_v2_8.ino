}
async function uploadFirmware(file,button){
  button.disabled=true;const f=new FormData();f.append('firmware',file,file.name);
  const msg=document.getElementById('fwMessage'),began=Date.now(),ticker=setInterval(()=>{msg.textContent=T[lang].waiting+' '+Math.floor((Date.now()-began)/1000)+' s'},1000);
