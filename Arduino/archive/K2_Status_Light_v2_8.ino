let lang='en',initialized=false,lastStatus={},simBusy=false,simQueued=null;
function setLang(l){if(!T[l])l='en';lang=l;document.documentElement.lang=l;localStorage.setItem('k2lang',l);document.querySelectorAll('[data-i]').forEach(e=>{e.textContent=T[l][e.dataset.i]||T.en[e.dataset.i]||e.textContent});document.querySelectorAll('[data-aria-i]').forEach(e=>e.setAttribute('aria-label',T[l][e.dataset.ariaI]||T.en[e.dataset.ariaI]));document.querySelectorAll('.toast button').forEach(e=>e.setAttribute('aria-label',T[l].close));for(const id of Object.keys(T).filter(x=>['en','pl','es','de'].includes(x)))document.getElementById(id).classList.toggle('active',l===id);paintStatus(lastStatus);if(availableUpdate)document.getElementById('githubMessage').textContent=T[l].newVersion+' '+availableUpdate.version;if(initialized){lastConnectionKey=null;refresh()}}
const GITHUB_MANIFEST='https://raw.githubusercontent.com/TomaszK00/Creality-K2-Status-Light/main/Software/update.json';
let availableUpdate=null;
const rowIds=['progress','heating','paused','complete','error','standby'];
const rowLabels=['printing','heating','paused','complete','error','standby'];
const rowContainer=document.getElementById('ledRows');
for(const [i,id] of rowIds.entries()){const row=document.createElement('div');row.className='led-row';const effects='<option value="0" data-i="allBar">Whole bar</option><option value="1" data-i="lastPair">Last pair</option><option value="2" data-i="scanner">Scanner (Knight Rider)</option><option value="3" data-i="centreOut">Centre → edges → centre</option><option value="4" data-i="edgesIn">Edges → centre → edges</option><option value="5" data-i="wave">Flowing wave</option>'; row.innerHTML=`<label class="row-title" data-i="${rowLabels[i]}" for="c_${id}"></label><div><span class="field-label" data-i="colour"></span><input type="color" name="c_${id}" id="c_${id}" data-aria-i="colour"></div><div><span class="field-label" data-i="brightness"></span><input type="number" name="b_${id}" id="b_${id}" min="1" max="100" data-aria-i="brightness"></div><div><span class="field-label" data-i="pulsing"></span><input type="checkbox" name="pe_${id}" id="pe_${id}" data-aria-i="pulsing"></div><div><span class="field-label" data-i="pulsePeriod"></span><input type="number" name="pp_${id}" id="pp_${id}" min="200" max="10000" step="100" data-aria-i="pulsePeriod"></div><div><span class="field-label" data-i="effect"></span><select name="ps_${id}" id="ps_${id}" data-aria-i="effect">${effects}</select></div>`;rowContainer.append(row)}
function applyRows(rows){for(const id of rowIds){const r=rows[id];document.getElementById('c_'+id).value=r.color;document.getElementById('b_'+id).value=r.brightness;document.getElementById('pe_'+id).checked=r.pulse;document.getElementById('pp_'+id).value=r.period;document.getElementById('ps_'+id).value=r.style}}
function toast(message,error=false,sticky=false,key=''){if(!message)return;if(key)document.querySelector(`[data-toast-key="${key}"]`)?.remove();const box=document.createElement('div');box.className='toast'+(error?' error':'');if(key)box.dataset.toastKey=key;if(sticky)box.dataset.sticky='true';const close=document.createElement('button');close.type='button';close.textContent='×';close.setAttribute('aria-label',T[lang].close);close.onclick=()=>box.remove();box.append(close,document.createTextNode(message));document.getElementById('toasts').prepend(box);const removable=[...document.querySelectorAll('.toast:not([data-sticky="true"])')];while(document.querySelectorAll('.toast').length>4&&removable.length)removable.pop().remove();if(!sticky)setTimeout(()=>box.remove(),6500)}

document.getElementById('openNetwork').onclick=()=>document.getElementById('networkDialog').showModal();
document.getElementById('closeNetwork').onclick=()=>document.getElementById('networkDialog').close();

function buildBar(pairs){const bar=document.getElementById('bar');if(bar.children.length===pairs)return;bar.replaceChildren();bar.style.gridTemplateColumns=`repeat(${pairs},minmax(0,1fr))`;for(let i=0;i<pairs;i++){const pair=document.createElement('div');pair.className='pair';for(let j=0;j<2;j++){const led=document.createElement('div');led.className='led';pair.append(led)}bar.append(pair)}}
async function api(path,options){const r=await fetch(path,options);if(!r.ok)throw Error(await r.text());return r.json()}
function paintStatus(s){if(!s||!s.rows)return;const state=s.sim?s.simState:(s.connected?s.state:'standby'),id=state==='printing'?'progress':state,prog=s.sim?s.simProgress:s.progress*100,pairs=s.ledCount/2,r=s.rows[id];if(!r)return;const count=state==='printing'?Math.ceil(prog*pairs/100):(state==='standby'&&!r.pulse?0:pairs);buildBar(pairs);const color=document.getElementById('c_'+id)?.value||r.color,bright=Number(document.getElementById('b_'+id)?.value||r.brightness)/100,pulse=document.getElementById('pe_'+id)?.checked??r.pulse,period=Number(document.getElementById('pp_'+id)?.value||r.period),style=Number(document.getElementById('ps_'+id)?.value??r.style);document.getElementById('percent').textContent=Math.round(prog)+'%';document.getElementById('ledcount').textContent=count+' / '+pairs;document.getElementById('displaystate').textContent=(s.sim?T[lang].test+' · ':'')+(T[lang][state]||state);document.getElementById('file').textContent=s.filename||'';document.getElementById('file').style.display=s.filename?'':'none';const cycle=Math.max(200,period),phase=(Date.now()%cycle)/cycle,wave=(1-Math.cos(2*Math.PI*phase))/2,scale=.25+.75*wave,travel=phase*2*Math.max(0,count-1),head=travel<=count-1?travel:2*(count-1)-travel,centre=(count-1)/2,radius=Math.max(.5,centre),outward=1-Math.abs(2*phase-1),front=(style===3?outward:1-outward)*radius;[...document.querySelectorAll('.pair')].forEach((p,i)=>[...p.children].forEach(led=>{const lit=i<count;let level=1;if(pulse&&lit){if(style===2)level=Math.max(.08,1-Math.abs(i-head)/2.2);else if(style===3||style===4)level=Math.max(.08,1-Math.abs(Math.abs(i-centre)-front)/1.3);else if(style===5)level=.16+.84*(.5+.5*Math.cos(2*Math.PI*(i/Math.max(1,count-1)-phase)));else if(style===0||(style===1&&i===count-1))level=scale}led.style.background=lit?color:'#e3ebe5';led.style.opacity=lit?Math.max(.05,bright*level):1;led.style.boxShadow=lit?'0 0 7px '+color+'40':'none'}))}

let lastConnectionKey=null;
async function refresh(){try{const s=await api('/api/status');lastStatus=s;if(!initialized){for(const [id,v] of Object.entries({ssid:s.ssid,ip:s.ip,port:s.port,ledCount:s.ledCount}))document.getElementById(id).value=v;applyRows(s.rows);document.getElementById('testStatus').value=s.simState;document.getElementById('simLoop').checked=s.simLoop;initialized=true}document.getElementById('manualProgress').value=s.simProgress;document.getElementById('manualPct').textContent=s.simProgress+'%';document.getElementById('sim').checked=s.sim;document.getElementById('autoProgress').checked=s.simRunning;paintStatus(s);const key=[s.ap,s.connected,s.connected?'':s.error].join('|');if(key!==lastConnectionKey){lastConnectionKey=key;toast(s.connected?T[lang].connected:(s.ap?T[lang].setupOffline:T[lang].offline+(s.error&&s.error!=='No printer connection (setup AP)'?' · '+localError(s.error):'')),!s.connected,!s.connected,'connection')}}catch(e){if(lastConnectionKey!=='device-offline'){lastConnectionKey='device-offline';toast(T[lang].deviceOffline,true,true,'connection')}}}

function localError(message){if(message==='Invalid Moonraker URL')return T[lang].invalidMoonraker;if(message==='Missing printer fields')return T[lang].missingFields;if(message==='Invalid IP, port or SSID')return T[lang].invalidNetwork;if(message==='Invalid LED count')return T[lang].invalidLedCount;if(message.startsWith('Invalid LED row:'))return T[lang].invalidLedRow;if(message.includes('Not Enough Space'))return T[lang].noSpace;if(message.startsWith('JSON:'))return 'JSON: '+message.slice(5);return message}
async function postForm(path,form){const r=await fetch(path,{method:'POST',body:new URLSearchParams(new FormData(form))});if(!r.ok)throw Error(await r.text());return r.text()}
document.getElementById('networkForm').onsubmit=async e=>{e.preventDefault();try{const msg=await postForm('/api/network',e.target),label=msg.includes('RESET')?T[lang].networkRestart:T[lang].networkSaved;document.getElementById('netMessage').textContent=label;toast(label)}catch(err){document.getElementById('netMessage').textContent=localError(err.message);toast(localError(err.message),true)}};
let lightTimer,lightSaveChain=Promise.resolve(),resettingColors=false;
const lightForm=document.getElementById('lightForm'),lightMessage=document.getElementById('lightMessage');
function scheduleLightSave(){if(resettingColors)return;clearTimeout(lightTimer);lightTimer=setTimeout(saveLightSettings,450)}
function saveLightSettings(){if(resettingColors||!lightForm.checkValidity())return;clearTimeout(lightTimer);lightMessage.textContent=T[lang].saving;lightSaveChain=lightSaveChain.catch(()=>{}).then(async()=>{if(resettingColors)return;try{await postForm('/api/lighting',lightForm);lightMessage.textContent=T[lang].saved;toast(T[lang].saved);await refresh()}catch(err){lightMessage.textContent=localError(err.message);toast(localError(err.message),true)}});return lightSaveChain}
lightForm.addEventListener('input',e=>{if(e.target.type!=='color')scheduleLightSave()});
lightForm.addEventListener('change',scheduleLightSave);
lightForm.onsubmit=e=>{e.preventDefault();saveLightSettings()};
document.getElementById('resetColors').onclick=async()=>{clearTimeout(lightTimer);resettingColors=true;const button=document.getElementById('resetColors');button.disabled=true;try{await lightSaveChain.catch(()=>{});const settings=await api('/api/lighting/defaults',{method:'POST'});document.getElementById('ledCount').value=settings.ledCount;applyRows(settings.rows);lastStatus={...lastStatus,...settings};paintStatus(lastStatus);lightMessage.textContent=T[lang].saved;toast(T[lang].saved)}catch(err){lightMessage.textContent=localError(err.message);toast(localError(err.message),true)}finally{button.disabled=false;resettingColors=false}};

async function scanWifi(){const list=document.getElementById('wifiList');list.replaceChildren(new Option(T[lang].scanning,''));try{const s=await api('/api/wifi/scan');list.replaceChildren(new Option('—',''));s.networks.forEach(n=>list.add(new Option(n.ssid+' ('+n.rssi+' dBm) '+(n.secure?'🔒':''),n.ssid)))}catch(e){list.replaceChildren(new Option(T[lang].scanError,''))}}
async function sendSimulation(extra={}){simQueued={...(simQueued||{}),...extra};if(simBusy)return;simBusy=true;try{while(simQueued){const action=simQueued;simQueued=null;const p=new URLSearchParams({enabled:document.getElementById('sim').checked?'1':'0',status:document.getElementById('testStatus').value,progress:document.getElementById('manualProgress').value,loop:document.getElementById('simLoop').checked?'1':'0',...action});await api('/api/simulation',{method:'POST',body:p});await refresh()}}catch(e){document.getElementById('simMessage').textContent=e.message}finally{simBusy=false}}
function simToggle(){if(!document.getElementById('sim').checked)document.getElementById('autoProgress').checked=false;sendSimulation({run:'0'})}function testStatusChanged(){if(document.getElementById('testStatus').value!=='printing'){document.getElementById('autoProgress').checked=false;sendSimulation({run:'0'})}else sendSimulation()}function toggleAutoProgress(){const play=document.getElementById('autoProgress').checked;if(play){document.getElementById('sim').checked=true;document.getElementById('testStatus').value='printing';document.getElementById('manualProgress').value=0}sendSimulation({run:play?'1':'0',...(play?{progress:'0'}:{})})}
const sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms));
async function waitForRestart(confirmed,startVersion){let wentOffline=false,consecutive=0;const began=Date.now();await sleep(1200);while(Date.now()-began<180000){try{const r=await fetch('/api/status?probe='+Date.now(),{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const status=await r.json();if(wentOffline||status.version!==startVersion||(confirmed&&Date.now()-began>6000)){if(++consecutive>=2){location.replace('/?updated='+Date.now());return}}}catch(_){wentOffline=true;consecutive=0}await sleep(1800)}throw Error(T[lang].retry)}
// SHA-256 works on the local HTTP panel too, where SubtleCrypto may be unavailable.
function sha256(bytes){
  const primes=[];for(let n=2;primes.length<64;n++){let prime=true;for(let d=2;d*d<=n;d++)if(n%d===0){prime=false;break}if(prime)primes.push(n)}
  const frac=x=>Math.floor((x-Math.floor(x))*4294967296)>>>0;
  const k=primes.map(x=>frac(Math.cbrt(x))),h=primes.slice(0,8).map(x=>frac(Math.sqrt(x)));
  const size=bytes.length,pad=((size+9+63)>>6)<<6,data=new Uint8Array(pad);data.set(bytes);data[size]=128;
  const bitLen=size*8;for(let i=0;i<8;i++)data[pad-1-i]=Math.floor(bitLen/2**(i*8))&255;
  const rr=(v,n)=>(v>>>n)|(v<<(32-n)),w=new Uint32Array(64);
  for(let offset=0;offset<pad;offset+=64){
    for(let i=0;i<16;i++){let j=offset+i*4;w[i]=(data[j]<<24)|(data[j+1]<<16)|(data[j+2]<<8)|data[j+3]}
    for(let i=16;i<64;i++){let a=w[i-15],b=w[i-2];w[i]=(w[i-16]+(rr(a,7)^rr(a,18)^(a>>>3))+w[i-7]+(rr(b,17)^rr(b,19)^(b>>>10)))|0}
    let [a,b,c,d,e,f,g,q]=h;
    for(let i=0;i<64;i++){let t1=(q+(rr(e,6)^rr(e,11)^rr(e,25))+((e&f)^(~e&g))+k[i]+w[i])|0,t2=((rr(a,2)^rr(a,13)^rr(a,22))+((a&b)^(a&c)^(b&c)))|0;q=g;g=f;f=e;e=(d+t1)|0;d=c;c=b;b=a;a=(t1+t2)|0}
    [a,b,c,d,e,f,g,q].forEach((v,i)=>h[i]=(h[i]+v)|0)
  }
