String normalizeColor(String c, const String& fallback) {
  if(c.length()!=7 || c[0]!='#')return fallback;
  for(int i=1;i<7;i++)if(!isxdigit((unsigned char)c[i]))return fallback;
  c.toLowerCase();return c;
}
uint32_t color24(const String& h) {return strtoul(h.c_str()+1,nullptr,16);}
void loadSettings(){
  prefs.begin("k2led",true);
  ssid=prefs.getString("ssid","");wifiPassword=prefs.getString("pass","");
  printerIP=prefs.getString("ip","192.168.1.9");printerPort=prefs.getUShort("port",7125);
  intervalMs=constrain(prefs.getInt("intvl",500),100,10000);
  activeLedCount=prefs.getInt("ledcnt",24)==12?12:24;
  int oldBright=constrain(prefs.getInt("bright",65),1,100);
  int oldPeriod=constrain(prefs.getInt("pulsems",1400),200,10000);
  uint8_t oldMask=prefs.isKey("pmask")?prefs.getUChar("pmask",0):0;
  bool oldLast=prefs.getBool("plast",false);
  if(!prefs.isKey("pmask")){String mode=prefs.getString("pulsemode","off");oldMask=mode=="all"?0x1f:(mode=="last"?1:0);oldLast=mode=="last";}
  for(int i=0;i<6;i++){
    String key=String(i);
    String oldColor=i==0?prefs.getString("color",DEFAULT_ROW_COLORS[0]):prefs.getString((String("c")+i).c_str(),DEFAULT_ROW_COLORS[i]);
    rowColors[i]=normalizeColor(prefs.getString((String("rc")+key).c_str(),oldColor),DEFAULT_ROW_COLORS[i]);
    rowBrightness[i]=constrain(prefs.getInt((String("rb")+key).c_str(),oldBright),1,100);
    rowPulse[i]=prefs.getBool((String("re")+key).c_str(),(oldMask&(1<<i))!=0);
    rowEnabled[i]=prefs.getBool((String("ri")+key).c_str(),true);
    rowStyle[i]=constrain((int)prefs.getUChar((String("rs")+key).c_str(),(i==0&&oldLast)?1:0),0,5);if(rowStyle[i]==4)rowStyle[i]=3;
    rowPeriod[i]=constrain(prefs.getInt((String("rp")+key).c_str(),oldPeriod),200,10000);
  }
  prefs.end();
}
void saveNetwork(){prefs.begin("k2led",false);prefs.putString("ssid",ssid);prefs.putString("pass",wifiPassword);prefs.putString("ip",printerIP);prefs.putUShort("port",printerPort);prefs.end();}
void saveLighting(){prefs.begin("k2led",false);prefs.putInt("intvl",intervalMs);prefs.putInt("ledcnt",activeLedCount);for(int i=0;i<6;i++){String key=String(i);prefs.putString((String("rc")+key).c_str(),rowColors[i]);prefs.putInt((String("rb")+key).c_str(),rowBrightness[i]);prefs.putBool((String("re")+key).c_str(),rowPulse[i]);prefs.putBool((String("ri")+key).c_str(),rowEnabled[i]);prefs.putUChar((String("rs")+key).c_str(),rowStyle[i]);prefs.putInt((String("rp")+key).c_str(),rowPeriod[i]);}prefs.end();}
void addRows(JsonDocument& d){for(int i=0;i<6;i++){const char* name=i==0?"progress":stateNames[i];d["rows"][name]["color"]=rowColors[i];d["rows"][name]["brightness"]=rowBrightness[i];d["rows"][name]["pulse"]=rowPulse[i];d["rows"][name]["enabled"]=rowEnabled[i];d["rows"][name]["period"]=rowPeriod[i];d["rows"][name]["style"]=rowStyle[i];}}

int statusIndex(String st){if(st=="printing")return 0;if(st=="heating")return 1;if(st=="paused")return 2;if(st=="complete")return 3;if(st=="error")return 4;return 5;}
String normalState(String s){s.toLowerCase();if(s=="complete"||s=="completed")return "complete";if(s=="printing")return "printing";if(s=="paused")return "paused";if(s=="error"||s=="cancelled")return "error";if(s=="heating")return "heating";return "standby";}
void updateLEDs(){
  if(!LED_ENABLED)return;
  String st=simEnabled?String(stateNames[simStatus]):normalState(printerState);
  if(!simEnabled&&!printerConnected)st="standby";
  int idx=statusIndex(st),pairs=activeLedCount/2;
  int count=st=="printing"?(int)ceilf((simEnabled?simProgress:printerProgress*100.0f)*pairs/100.0f):(st=="standby"&&!rowPulse[idx]?0:pairs);
  count=constrain(count,0,pairs);if(!rowEnabled[idx])count=0;
  uint32_t rgb=color24(rowColors[idx]);uint8_t r=(rgb>>16)&255,g=(rgb>>8)&255,b=rgb&255;
  float cycle=(millis()%rowPeriod[idx])/(float)rowPeriod[idx];
  float scale=0.625f-0.375f*cosf(6.2831853f*cycle);
  float travel=cycle*2.0f*fmaxf(0,count-1);float head=travel<=count-1?travel:2.0f*(count-1)-travel;float centre=(count-1)/2.0f;float radius=fmaxf(0.5f,centre);float outward=1.0f-fabsf(2.0f*cycle-1.0f);float front=outward*radius;
  strip.setBrightness(map(rowBrightness[idx],0,100,0,255));
  for(int i=0;i<LED_COUNT;i++){
    int pair=i/2;bool lit=i<activeLedCount&&pair<count;float level=1.0f;
    if(lit&&rowPulse[idx]){
      if(rowStyle[idx]==2)level=fmaxf(0.08f,1.0f-fabsf(pair-head)/2.2f);
      else if(rowStyle[idx]==3)level=fmaxf(0.08f,1.0f-fabsf(fabsf(pair-centre)-front)/1.3f);
      else if(rowStyle[idx]==5)level=0.16f+0.84f*(0.5f+0.5f*cosf(6.2831853f*(pair/fmaxf(1,count-1)-cycle)));
      else if(rowStyle[idx]==0||(rowStyle[idx]==1&&pair==count-1))level=scale;
    }
    strip.setPixelColor(i,lit?strip.Color((uint8_t)(r*level),(uint8_t)(g*level),(uint8_t)(b*level),0):strip.Color(0,0,0,0));
  }
  strip.show();
}

void startNetwork(){
  WiFi.mode(WIFI_STA);
  if(ssid.length()){
    WiFi.begin(ssid.c_str(),wifiPassword.c_str());
    Serial.print("Connecting WiFi");
    for(int i=0;i<40 && WiFi.status()!=WL_CONNECTED;i++){delay(250);Serial.print('.');}
  }
  if(WiFi.status()==WL_CONNECTED){configTime(0,0,"pool.ntp.org","time.cloudflare.com");Serial.println("\nPanel: http://"+WiFi.localIP().toString());if(MDNS.begin("k2-led"))Serial.println("mDNS: http://k2-led.local");}
  else{apMode=true;WiFi.mode(WIFI_AP_STA);WiFi.softAP(AP_NAME,AP_PASSWORD);Serial.println("\nSetup AP: K2-LED-Setup · http://192.168.4.1");}
}
void pollPrinter(){
  if(apMode || WiFi.status()!=WL_CONNECTED){printerConnected=false;lastError="No printer connection (setup AP)";return;}
  WiFiClient client;HTTPClient http;
  String url="http://"+printerIP+":"+String(printerPort)+"/printer/objects/query?print_stats&virtual_sdcard";
  http.setTimeout(1700);
  if(!http.begin(client,url)){printerConnected=false;lastError="Invalid Moonraker URL";return;}
  int response=http.GET();if(response!=200){printerConnected=false;lastError="HTTP "+String(response);http.end();return;}
  JsonDocument doc;DeserializationError err=deserializeJson(doc,http.getStream());http.end();
  if(err){printerConnected=false;lastError=String("JSON: ")+err.c_str();return;}
  JsonVariant status=doc["result"]["status"];
  if(status["print_stats"].isNull()||status["virtual_sdcard"].isNull()){printerConnected=false;lastError="Missing printer fields";return;}
  printerState=status["print_stats"]["state"].as<String>();printerFile=status["print_stats"]["filename"].as<String>();
  printerProgress=constrain(status["virtual_sdcard"]["progress"].as<float>(),0.f,1.f);
  printerConnected=true;lastError="";
}
void jsonReply(int code, JsonDocument& d){String s;serializeJson(d,s);server.send(code,"application/json",s);}
bool newerVersion(const String& version){
  int major=0,minor=0,patch=0;
  if(sscanf(version.c_str(),"%d.%d.%d",&major,&minor,&patch)<2)return false;
  return major>2||(major==2&&minor>11)||(major==2&&minor==11&&patch>0);
}
void checkGithubUpdate(){
  if(apMode||WiFi.status()!=WL_CONNECTED||time(nullptr)<1600000000)return;
  WiFiClientSecure client;
  client.setCACertBundle(GITHUB_CA_BUNDLE,sizeof(GITHUB_CA_BUNDLE));
  HTTPClient http;
  http.setTimeout(5500);
  if(!http.begin(client,"https://api.github.com/repos/TomaszK00/Creality-K2-Status-Light/contents/Software?ref=main"))return;
  http.addHeader("User-Agent","K2-Status-Light/2.11");
  http.addHeader("Accept","application/vnd.github+json");
  const int code=http.GET();
  if(code==200){
    JsonDocument listing;
    DeserializationError error=deserializeJson(listing,http.getString());
    if(!error&&listing.is<JsonArray>()){
      bool found=false,newer=false;
      for(JsonObject file:listing.as<JsonArray>()){
        String name=file["name"]|String("");
        if(!name.startsWith("K2_Status_Light_v")||!name.endsWith("_OTA.bin"))continue;
        String version=name.substring(17,name.length()-8);version.replace('_','.');
        if(version.length()){found=true;if(newerVersion(version))newer=true;}
      }
      if(found)updateAvailable=newer;
    }
  }
  http.end();
}
void routes(){
  server.on("/",HTTP_GET,[](){server.sendHeader("Cache-Control","no-store");server.send_P(200,"text/html; charset=utf-8",PAGE);});
  server.on("/api/status",HTTP_GET,[](){JsonDocument d;d["version"]="2.11";d["updateAvailable"]=updateAvailable;d["connected"]=printerConnected;d["ap"]=apMode;d["state"]=normalState(printerState);d["progress"]=printerProgress;d["filename"]=printerFile;d["error"]=lastError;d["ssid"]=ssid;d["ip"]=printerIP;d["port"]=printerPort;d["interval"]=intervalMs;d["ledCount"]=activeLedCount;d["simLoop"]=simLoop;d["sim"]=simEnabled;d["simState"]=stateNames[simStatus];d["simProgress"]=simProgress;d["simRunning"]=simRun;addRows(d);jsonReply(200,d);});
  server.on("/api/wifi/scan",HTTP_GET,[](){int n=WiFi.scanNetworks(false,true);JsonDocument d;JsonArray a=d["networks"].to<JsonArray>();for(int i=0;i<n && i<35;i++){String name=WiFi.SSID(i);if(name.isEmpty())continue;JsonObject net=a.add<JsonObject>();net["ssid"]=name;net["rssi"]=WiFi.RSSI(i);net["secure"]=WiFi.encryptionType(i)!=WIFI_AUTH_OPEN;}WiFi.scanDelete();jsonReply(200,d);});
  server.on("/api/network",HTTP_POST,[](){String newSSID=server.arg("ssid"),newIP=server.arg("ip");newSSID.trim();newIP.trim();int port=server.arg("port").toInt();IPAddress parsed;if(!parsed.fromString(newIP)||port<1||port>65535||newSSID.length()>32){server.send(400,"text/plain","Invalid IP, port or SSID");return;}bool changed=(ssid!=newSSID||server.arg("pass").length()>0);ssid=newSSID;printerIP=newIP;printerPort=port;if(server.arg("pass").length())wifiPassword=server.arg("pass");saveNetwork();server.send(200,"text/plain; charset=utf-8",changed?"Saved. Press RESET to reconnect to the new Wi-Fi. / Zapisano. Naciśnij RESET.":"Saved / Zapisano");});
  server.on("/api/lighting",HTTP_POST,[](){
    int leds=server.arg("ledCount").toInt();
    if(leds!=12&&leds!=24){server.send(400,"text/plain","Invalid LED count");return;}
    String colors[6];uint8_t br[6],styles[6];bool enabled[6],lightsOn[6];uint16_t periods[6];
    for(int i=0;i<6;i++){
      String id=i==0?"progress":String(stateNames[i]);
      colors[i]=normalizeColor(server.arg("c_"+id),"");int b=server.arg("b_"+id).toInt(),p=server.arg("pp_"+id).toInt(),style=server.arg("ps_"+id).toInt();
      if(colors[i].isEmpty()||b<1||b>100||p<200||p>10000||style<0||style>5||style==4){server.send(400,"text/plain","Invalid LED row: "+id);return;}
      br[i]=b;periods[i]=p;styles[i]=style;enabled[i]=server.hasArg("pe_"+id);lightsOn[i]=server.hasArg("on_"+id);
    }
    activeLedCount=leds;
    for(int i=0;i<6;i++){rowColors[i]=colors[i];rowBrightness[i]=br[i];rowPeriod[i]=periods[i];rowStyle[i]=styles[i];rowPulse[i]=enabled[i];rowEnabled[i]=lightsOn[i];}
    saveLighting();updateLEDs();server.send(200,"text/plain","Saved");
  });
  server.on("/api/lighting/defaults",HTTP_POST,[](){
    activeLedCount=24;intervalMs=500;
    for(int i=0;i<6;i++){rowColors[i]=DEFAULT_ROW_COLORS[i];rowBrightness[i]=65;rowPulse[i]=false;rowEnabled[i]=true;rowStyle[i]=0;rowPeriod[i]=1400;}
    saveLighting();updateLEDs();JsonDocument d;d["ok"]=true;d["ledCount"]=activeLedCount;d["interval"]=intervalMs;addRows(d);jsonReply(200,d);
  });
  server.on("/api/simulation",HTTP_POST,[](){simEnabled=server.arg("enabled")=="1";simStatus=statusIndex(server.arg("status"));simProgress=constrain(server.arg("progress").toInt(),0,100);simLoop=server.arg("loop")=="1";if(server.hasArg("run")){simRun=simEnabled&&server.arg("run")=="1";lastSimulationStep=millis();}if(!simEnabled)simRun=false;updateLEDs();JsonDocument d;d["ok"]=true;jsonReply(200,d);});
  server.on("/api/update/available",HTTP_POST,[](){updateAvailable=server.arg("available")=="1";server.send(200,"text/plain","OK");});
  server.on("/api/update",HTTP_POST,[](){bool ok=!Update.hasError()&&updateError.isEmpty();server.send(ok?200:500,"text/plain",ok?"OK":("Update failed: "+updateError));delay(350);if(ok)ESP.restart();},[](){HTTPUpload& upload=server.upload();if(upload.status==UPLOAD_FILE_START){updateError="";if(!upload.filename.endsWith(".bin")){updateError="Expected .bin";return;}if(!Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH))updateError=Update.errorString();}else if(upload.status==UPLOAD_FILE_WRITE){if(updateError.isEmpty()&&Update.write(upload.buf,upload.currentSize)!=upload.currentSize)updateError=Update.errorString();}else if(upload.status==UPLOAD_FILE_END){if(updateError.isEmpty()&&!Update.end(true))updateError=Update.errorString();}else if(upload.status==UPLOAD_FILE_ABORTED){Update.abort();updateError="Aborted";}});
}
void setup(){pinMode(STATUS_LED_PIN,OUTPUT);digitalWrite(STATUS_LED_PIN,HIGH);Serial.begin(115200);delay(450);loadSettings();if(LED_ENABLED){strip.begin();strip.clear();strip.show();}startNetwork();routes();server.begin();Serial.println("K2 Status Light v2.11 web server ready");}
void loop(){
  server.handleClient();
  uint32_t now=millis();
  // One, two or three short flashes per cycle; onboard LED is active LOW.
  uint8_t flashes=(apMode||WiFi.status()!=WL_CONNECTED)?1:(updateAvailable?3:2);
  uint32_t beat=now%1200;
  digitalWrite(STATUS_LED_PIN,(beat<90||(flashes>=2&&beat>=200&&beat<290)||(flashes>=3&&beat>=400&&beat<490))?LOW:HIGH);
  if(WiFi.status()==WL_CONNECTED&&!apMode&&time(nullptr)>1600000000&&now>15000&&(lastUpdateCheck==0||now-lastUpdateCheck>=1800000UL)){
    lastUpdateCheck=now;
    checkGithubUpdate();
  }
  if(now-lastPoll>2200){lastPoll=now;if(!simEnabled){pollPrinter();updateLEDs();}}
  if(simRun&&now-lastSimulationStep>=(uint32_t)intervalMs){
    lastSimulationStep=now;
    if(simProgress>=100){if(simLoop)simProgress=0;else simRun=false;}
    else {simProgress=min(100,simProgress+9);if(simProgress>=100&&!simLoop)simRun=false;}
    updateLEDs();
  }
  if(rowPulse[statusIndex(simEnabled?String(stateNames[simStatus]):(!printerConnected?String("standby"):normalState(printerState)))]&&now-lastPulseFrame>=40){lastPulseFrame=now;updateLEDs();}
  delay(2);
}

