function paintStatus(s){if(!s||!s.rows)return;const state=s.sim?s.simState:(s.connected?s.state:'standby'),id=state==='printing'?'progress':state,prog=s.sim?s.simProgress:s.progress*100,pairs=s.ledCount/2,r=s.rows[id];if(!r)return;let count=state==='printing'?Math.ceil(prog*pairs/100):(state==='standby'&&!r.pulse?0:pairs);const enabled=document.getElementById('on_'+id)?.checked??(r.enabled!==false);if(!enabled)count=0;buildBar(pairs);const color=document.getElementById('c_'+id)?.value||r.color,bright=Number(document.getElementById('b_'+id)?.value||r.brightness)/100,pulse=document.getElementById('pe_'+id)?.checked??r.pulse,period=Number(document.getElementById('pp_'+id)?.value||r.period),style=Number(document.getElementById('ps_'+id)?.value??r.style);document.getElementById('percent').textContent=Math.round(prog)+'%';document.getElementById('ledcount').textContent=count+' / '+pairs;document.getElementById('displaystate').textContent=(s.sim?T[lang].test+' · ':'')+(T[lang][state]||state);document.getElementById('file').textContent=s.filename||'';document.getElementById('file').style.display=s.filename?'':'none';const cycle=Math.max(200,period),phase=(Date.now()%cycle)/cycle,wave=(1-Math.cos(2*Math.PI*phase))/2,scale=.25+.75*wave,travel=phase*2*Math.max(0,count-1),head=travel<=count-1?travel:2*(count-1)-travel,centre=(count-1)/2,radius=Math.max(.5,centre),outward=1-Math.abs(2*phase-1),front=outward*radius;[...document.querySelectorAll('.pair')].forEach((p,i)=>[...p.children].forEach(led=>{const lit=i<count;let level=1;if(pulse&&lit){if(style===2)level=Math.max(.08,1-Math.abs(i-head)/2.2);else if(style===3)level=Math.max(.08,1-Math.abs(Math.abs(i-centre)-front)/1.3);else if(style===5)level=.16+.84*(.5+.5*Math.cos(2*Math.PI*(i/Math.max(1,count-1)-phase)));else if(style===0||(style===1&&i===count-1))level=scale}led.style.background=lit?color:'#e3ebe5';led.style.opacity=lit?Math.max(.05,bright*level):1;led.style.boxShadow=lit?'0 0 7px '+color+'40':'none'}))}

